@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

@using FutureTechnologyE_Commerce.Models.ViewModels
@model HomeIndexViewModel
@{
    ViewData["Title"] = "Home - Future Tech";
}

<style>
    /* Hero Section Styles */
    .hero-section {
        padding: 4rem 0 3rem;
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        position: relative;
        overflow: hidden;
    }

    .hero-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%232563eb' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E") repeat;
        opacity: 0.3;
    }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .hero-image {
        position: relative;
        z-index: 2;
    }

    .floating-badge {
        position: absolute;
        top: 20px;
        right: 20px;
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
    }

    .trust-indicators {
        border-top: 1px solid #e2e8f0;
        padding-top: 2rem;
    }

    /* Promotions Carousel Styles */
    .promotions-section {
        background: white;
    }

    .promotion-slide {
        min-height: 400px;
        display: flex;
        align-items: center;
        padding: 3rem 0;
    }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
    }

    .bg-gradient-secondary {
        background: linear-gradient(135deg, #10b981, #059669);
    }

    .bg-gradient-accent {
        background: linear-gradient(135deg, #f59e0b, #d97706);
    }

    /* Countdown Timer */
    .timer-box {
        background: rgba(255, 255, 255, 0.2);
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: 8px;
        padding: 1rem;
        text-align: center;
        min-width: 80px;
        backdrop-filter: blur(10px);
    }

    .timer-value {
        display: block;
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
    }

    .timer-label {
        display: block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 0.25rem;
    }

    /* Price Highlight */
    .price-highlight {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .original-price {
        font-size: 1.25rem;
        text-decoration: line-through;
        opacity: 0.7;
    }

    .sale-price {
        font-size: 2rem;
        font-weight: 700;
    }

    .discount-badge {
        background: rgba(255, 255, 255, 0.2);
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-weight: 600;
        backdrop-filter: blur(10px);
    }

    /* Enhanced Categories Section */
    .categories-section {
        background: white;
        padding: 4rem 0;
    }

    .category-card {
        transition: all 0.3s ease;
        border: 2px solid transparent;
        height: 100%;
    }

    .category-card:hover {
        transform: translateY(-8px);
        border-color: var(--primary-color);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    .category-card .card-img-top {
        height: 120px;
        object-fit: contain;
        padding: 1rem;
        transition: all 0.3s ease;
    }

    .category-card:hover .card-img-top {
        transform: scale(1.1);
    }

    /* Enhanced Products Section */
    .products-section, .laptops-section {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        padding: 4rem 0;
    }

    .product-card {
        transition: all 0.3s ease;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

    .product-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
        transition: left 0.5s;
    }

    .product-card:hover::before {
        left: 100%;
    }

    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    .product-card .card-img-top {
        height: 200px;
        object-fit: cover;
        transition: all 0.3s ease;
    }

    .product-card:hover .card-img-top {
        transform: scale(1.05);
    }

    .price-section {
        position: relative;
    }

    .current-price {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--primary-color);
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .hero-section {
            padding: 2rem 0 1rem;
        }

        .hero-section .display-3 {
            font-size: 2rem;
        }

        .promotion-slide {
            min-height: 500px;
        }

        .timer-box {
            min-width: 60px;
            padding: 0.75rem 0.5rem;
        }

        .timer-value {
            font-size: 1.5rem;
        }

        .floating-badge {
            top: 10px;
            right: 10px;
        }

        .floating-badge .badge {
            font-size: 0.75rem;
        }
    }
</style>

<!-- Modern Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6">
                <div class="hero-content">
                    <span class="badge bg-warning text-dark mb-3">🔥 New Arrivals</span>
                    <h1 class="display-3 fw-bold mb-4">
                        Future <span class="text-gradient">Technology</span> Store
                    </h1>
                    <p class="lead mb-4 text-muted">
                        Discover cutting-edge electronics and tech gadgets. Premium quality, competitive prices, and exceptional service.
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        <a asp-action="GetAllProducts" class="btn btn-primary btn-lg">
                            <i class="bi bi-shop me-2"></i> Shop Now
                        </a>
                        <a asp-action="GetAllLaptops" class="btn btn-outline-primary btn-lg">
                            <i class="bi bi-laptop me-2"></i> View Laptops
                        </a>
                    </div>
                    
                    <!-- Trust Indicators -->
                    <div class="trust-indicators mt-5">
                        <div class="row g-3">
                            <div class="col-4">
                                <div class="text-center">
                                    <i class="bi bi-truck text-primary fs-4"></i>
                                    <p class="small mb-0 fw-semibold">Free Shipping</p>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="text-center">
                                    <i class="bi bi-shield-check text-success fs-4"></i>
                                    <p class="small mb-0 fw-semibold">Secure Payment</p>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="text-center">
                                    <i class="bi bi-arrow-repeat text-info fs-4"></i>
                                    <p class="small mb-0 fw-semibold">Easy Returns</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-image">
                    <img src="/images/ASUS TUF Gaming F15 Gaming Laptop.jpeg" alt="Featured Laptop" class="img-fluid rounded-4 shadow-lg">
                    <div class="floating-badge">
                        <span class="badge bg-danger fs-6">-20% OFF</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Promotions Carousel -->
<section class="promotions-section py-5">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="section-title">🎯 Hot Deals & Promotions</h2>
            <p class="text-muted">Limited time offers you don't want to miss!</p>
        </div>
        
        <div id="promotionsCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#promotionsCarousel" data-bs-slide-to="0" class="active"></button>
                <button type="button" data-bs-target="#promotionsCarousel" data-bs-slide-to="1"></button>
                <button type="button" data-bs-target="#promotionsCarousel" data-bs-slide-to="2"></button>
            </div>
            
            <div class="carousel-inner rounded-4 overflow-hidden shadow-lg">
                <div class="carousel-item active">
                    <div class="promotion-slide bg-gradient-primary">
                        <div class="row align-items-center h-100">
                            <div class="col-md-6 text-white p-5">
                                <span class="badge bg-light text-dark mb-3">FLASH SALE</span>
                                <h3 class="display-5 fw-bold mb-3">Gaming Laptops</h3>
                                <p class="mb-4">Up to 30% off on high-performance gaming laptops. Limited stock available!</p>
                                <div class="countdown-timer mb-4">
                                    <div class="d-flex gap-2">
                                        <div class="timer-box">
                                            <span class="timer-value" id="hours">23</span>
                                            <span class="timer-label">Hours</span>
                                        </div>
                                        <div class="timer-box">
                                            <span class="timer-value" id="minutes">45</span>
                                            <span class="timer-label">Minutes</span>
                                        </div>
                                        <div class="timer-box">
                                            <span class="timer-value" id="seconds">12</span>
                                            <span class="timer-label">Seconds</span>
                                        </div>
                                    </div>
                                </div>
                                <a asp-action="GetAllLaptops" class="btn btn-light btn-lg">
                                    Shop Now <i class="bi bi-arrow-right ms-2"></i>
                                </a>
                            </div>
                            <div class="col-md-6">
                                <img src="/images/ASUS TUF Gaming F15 Gaming Laptop.jpeg" alt="Gaming Laptop" class="img-fluid">
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="carousel-item">
                    <div class="promotion-slide bg-gradient-secondary">
                        <div class="row align-items-center h-100">
                            <div class="col-md-6 text-white p-5">
                                <span class="badge bg-light text-dark mb-3">WEEKEND DEAL</span>
                                <h3 class="display-5 fw-bold mb-3">Computer Accessories</h3>
                                <p class="mb-4">Get 25% off on mice, keyboards, and more. Upgrade your workspace today!</p>
                                <ul class="list-unstyled mb-4">
                                    <li><i class="bi bi-check-circle me-2"></i> Premium quality</li>
                                    <li><i class="bi bi-check-circle me-2"></i> Fast shipping</li>
                                    <li><i class="bi bi-check-circle me-2"></i> Warranty included</li>
                                </ul>
                                <a asp-action="GetFilteredProducts" asp-route-categoryFilter="Mouse" class="btn btn-light btn-lg">
                                    Browse Accessories <i class="bi bi-arrow-right ms-2"></i>
                                </a>
                            </div>
                            <div class="col-md-6">
                                <img src="~/images/IMG-20250408-WA0021.jpg" alt="Accessories" class="img-fluid rounded-3">
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="carousel-item">
                    <div class="promotion-slide bg-gradient-accent">
                        <div class="row align-items-center h-100">
                            <div class="col-md-6 text-white p-5">
                                <span class="badge bg-light text-dark mb-3">STORAGE SALE</span>
                                <h3 class="display-5 fw-bold mb-3">Storage Solutions</h3>
                                <p class="mb-4">Massive discounts on SSDs, HDDs, and external storage devices.</p>
                                <div class="price-highlight mb-4">
                                    <span class="original-price">EGP 5,000</span>
                                    <span class="sale-price">EGP 3,500</span>
                                    <span class="discount-badge">SAVE 30%</span>
                                </div>
                                <a asp-action="GetFilteredProducts" asp-route-categoryFilter="Storage" class="btn btn-light btn-lg">
                                    View Storage <i class="bi bi-arrow-right ms-2"></i>
                                </a>
                            </div>
                            <div class="col-md-6">
                                <img src="~/images/hard.jpg" alt="Storage" class="img-fluid rounded-3">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <button class="carousel-control-prev" type="button" data-bs-target="#promotionsCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#promotionsCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    </div>
</section>

<!-- Modern Categories Section -->
<section class="categories-section">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Shop By Categories</h2>
            <p class="text-muted">Explore our wide range of tech products</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-3 col-6">
                <div class="category-card card text-center h-100 shadow-hover">
                    <div class="card-body p-4">
                        <div class="category-icon mb-3">
                            <i class="bi bi-laptop text-primary" style="font-size: 3rem;"></i>
                        </div>
                        <img src="~/images/lab.jpg" class="card-img-top mb-3" alt="Laptops" style="height: 120px; object-fit: contain;">
                        <h5 class="card-title fw-bold">Laptops</h5>
                        <p class="card-text text-muted small">High-performance laptops for work and gaming</p>
                        <a asp-controller="Home" asp-action="GetAllLaptops" class="btn btn-outline-primary btn-sm mt-3">
                            Shop Now <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="category-card card text-center h-100 shadow-hover">
                    <div class="card-body p-4">
                        <div class="category-icon mb-3">
                            <i class="bi bi-mouse text-info" style="font-size: 3rem;"></i>
                        </div>
                        <img src="~/images/IMG-20250408-WA0021.jpg" class="card-img-top mb-3" alt="Mouse" style="height: 120px; object-fit: contain;">
                        <h5 class="card-title fw-bold">Mouse & Accessories</h5>
                        <p class="card-text text-muted small">Ergonomic mice and computer accessories</p>
                        <a asp-controller="Home" asp-action="GetFilteredProducts" asp-route-categoryFilter="Mouse" class="btn btn-outline-primary btn-sm mt-3">
                            Shop Now <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="category-card card text-center h-100 shadow-hover">
                    <div class="card-body p-4">
                        <div class="category-icon mb-3">
                            <i class="bi bi-hdd text-success" style="font-size: 3rem;"></i>
                        </div>
                        <img src="~/images/hard.jpg" class="card-img-top mb-3" alt="Storage" style="height: 120px; object-fit: contain;">
                        <h5 class="card-title fw-bold">Storage Solutions</h5>
                        <p class="card-text text-muted small">SSDs, HDDs, and external storage devices</p>
                        <a asp-controller="Home" asp-action="GetFilteredProducts" asp-route-categoryFilter="Storage" class="btn btn-outline-primary btn-sm mt-3">
                            Shop Now <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="category-card card text-center h-100 shadow-hover">
                    <div class="card-body p-4">
                        <div class="category-icon mb-3">
                            <i class="bi bi-printer text-warning" style="font-size: 3rem;"></i>
                        </div>
                        <img src="~/images/printer.jpg" class="card-img-top mb-3" alt="Printers" style="height: 120px; object-fit: contain;">
                        <h5 class="card-title fw-bold">Printers</h5>
                        <p class="card-text text-muted small">Professional printers for home and office</p>
                        <a asp-controller="Home" asp-action="GetFilteredProducts" asp-route-categoryFilter="Printer" class="btn btn-outline-primary btn-sm mt-3">
                            Shop Now <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modern Best Sellers Section -->
@if (Model.Products != null && Model.Products.Any())
{
    <section class="products-section" id="deals">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title">🔥 Best Sellers</h2>
                <p class="text-muted">Our most popular products loved by customers</p>
            </div>
            
            <div class="row g-4">
                @foreach (var product in Model.Products.Take(8))
                {
                    <div class="col-lg-3 col-md-4 col-6">
                        <div class="product-card card h-100">
                            <!-- Product Badges -->
                            <div class="position-absolute top-0 start-0 m-3 z-1">
                                @if (product.IsBestseller)
                                {
                                    <span class="badge bg-danger">Bestseller</span>
                                }
                            </div>
                            <div class="position-absolute top-0 end-0 m-3 z-1">
                                @if (product.StockQuantity > 0)
                                {
                                    <span class="badge bg-success">In Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Sold Out</span>
                                }
                            </div>
                            
                            <!-- Product Image -->
                            <div class="overflow-hidden">
                                <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;" onerror="this.src='/images/placeholder.svg'">
                            </div>
                            
                            <div class="card-body d-flex flex-column p-3">
                                <!-- Product Title -->
                                <h6 class="card-title fw-bold text-truncate-2 mb-2">@product.Name</h6>
                                
                                <!-- Rating Stars -->
                                <div class="text-warning mb-2">
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-half"></i>
                                    <span class="text-muted small ms-1">(4.5)</span>
                                </div>
                                
                                <!-- Price -->
                                <div class="price-section mb-3">
                                    <span class="current-price">@product.Price.ToString("N0") EGP</span>
                                    <span class="text-muted small text-decoration-line-through ms-2">@((product.Price * 1.2m).ToString("N0")) EGP</span>
                                </div>
                                
                                <!-- Add to Cart Button -->
                                <div class="mt-auto">
                                    @if (SignInManager.IsSignedIn(User))
                                    {
                                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@product.ProductID" />
                                            <button type="submit" class="btn btn-primary w-100 btn-sm" @(product.StockQuantity == 0 ? "disabled" : "")>
                                                <i class="bi bi-cart-plus me-1"></i> Add to Cart
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-controller="Cart" asp-action="RequestAddToCartAfterLogin" asp-route-productId="@product.ProductID" class="btn btn-primary w-100 btn-sm">
                                            <i class="bi bi-cart-plus me-1"></i> Add to Cart
                                        </a>
                                    }
                                </div>
                            </div>
                            
                            <!-- Quick Actions -->
                            <div class="card-footer bg-transparent border-0 p-2">
                                <div class="d-flex justify-content-center gap-2">
                                    <button class="btn btn-outline-secondary btn-sm" title="Quick View">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm" title="Add to Wishlist">
                                        <i class="bi bi-heart"></i>
                                    </button>
                                    <a asp-controller="Home" asp-action="Details" asp-route-id="@product.ProductID" class="btn btn-outline-secondary btn-sm" title="View Details">
                                        <i class="bi bi-info-circle"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            
            <!-- View All Button -->
            <div class="text-center mt-5">
                <a asp-action="GetFilteredProducts" asp-controller="Home" asp-route-categoryFilter="bestseller" class="btn btn-outline-primary btn-lg">
                    View All Best Sellers <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </section>
}

<!-- Modern Featured Laptops Section -->
@if (Model.Laptops != null && Model.Laptops.Any())
{
    <section class="laptops-section">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title">💻 Featured Laptops</h2>
                <p class="text-muted">High-performance laptops for professionals and gamers</p>
            </div>
            
            <div class="row g-4">
                @foreach (var laptop in Model.Laptops.Take(4))
                {
                    <div class="col-lg-3 col-md-4 col-6">
                        <div class="product-card card h-100">
                            <!-- Product Badges -->
                            <div class="position-absolute top-0 start-0 m-3 z-1">
                                <span class="badge bg-warning text-dark">Featured</span>
                            </div>
                            <div class="position-absolute top-0 end-0 m-3 z-1">
                                @if (laptop.StockQuantity > 0)
                                {
                                    <span class="badge bg-success">In Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Sold Out</span>
                                }
                            </div>
                            
                            <!-- Product Image -->
                            <div class="overflow-hidden">
                                <img src="@laptop.ImageUrl" class="card-img-top" alt="@laptop.Name" style="height: 200px; object-fit: cover;" onerror="this.src='/images/placeholder.svg'">
                            </div>
                            
                            <div class="card-body d-flex flex-column p-3">
                                <!-- Product Title -->
                                <h6 class="card-title fw-bold text-truncate-2 mb-2">@laptop.Name</h6>
                                
                                <!-- Laptop Specs -->
                                <div class="specs-list mb-2">
                                    <ul class="list-unstyled small text-muted">
                                        <li><i class="bi bi-cpu me-1"></i> High Performance</li>
                                        <li><i class="bi bi-memory me-1"></i> Fast Memory</li>
                                        <li><i class="bi bi-hdd me-1"></i> Large Storage</li>
                                    </ul>
                                </div>
                                
                                <!-- Rating Stars -->
                                <div class="text-warning mb-2">
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <span class="text-muted small ms-1">(5.0)</span>
                                </div>
                                
                                <!-- Price -->
                                <div class="price-section mb-3">
                                    <span class="current-price">@laptop.Price.ToString("N0") EGP</span>
                                    <span class="text-muted small text-decoration-line-through ms-2">@((laptop.Price * 1.15m).ToString("N0")) EGP</span>
                                </div>
                                
                                <!-- Add to Cart Button -->
                                <div class="mt-auto">
                                    @if (SignInManager.IsSignedIn(User))
                                    {
                                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@laptop.ProductID" />
                                            <button type="submit" class="btn btn-primary w-100 btn-sm" @(laptop.StockQuantity == 0 ? "disabled" : "")>
                                                <i class="bi bi-cart-plus me-1"></i> Add to Cart
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-controller="Cart" asp-action="RequestAddToCartAfterLogin" asp-route-productId="@laptop.ProductID" class="btn btn-primary w-100 btn-sm">
                                            <i class="bi bi-cart-plus me-1"></i> Add to Cart
                                        </a>
                                    }
                                </div>
                            </div>
                            
                            <!-- Quick Actions -->
                            <div class="card-footer bg-transparent border-0 p-2">
                                <div class="d-flex justify-content-center gap-2">
                                    <button class="btn btn-outline-secondary btn-sm" title="Quick View">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm" title="Compare">
                                        <i class="bi bi-arrow-left-right"></i>
                                    </button>
                                    <a asp-controller="Home" asp-action="Details" asp-route-id="@laptop.ProductID" class="btn btn-outline-secondary btn-sm" title="View Details">
                                        <i class="bi bi-info-circle"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            
            <!-- View All Button -->
            <div class="text-center mt-5">
                <a asp-action="GetAllLaptops" asp-controller="Home" class="btn btn-outline-primary btn-lg">
                    View All Laptops <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </section>
}

<!-- JavaScript for Countdown Timer -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Countdown Timer
        function updateCountdown() {
            const now = new Date();
            const tomorrow = new Date(now);
            tomorrow.setDate(tomorrow.getDate() + 1);
            tomorrow.setHours(0, 0, 0, 0);
            
            const diff = tomorrow - now;
            
            const hours = Math.floor(diff / (1000 * 60 * 60));
            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diff % (1000 * 60)) / 1000);
            
            const hoursEl = document.getElementById('hours');
            const minutesEl = document.getElementById('minutes');
            const secondsEl = document.getElementById('seconds');
            
            if (hoursEl) hoursEl.textContent = hours.toString().padStart(2, '0');
            if (minutesEl) minutesEl.textContent = minutes.toString().padStart(2, '0');
            if (secondsEl) secondsEl.textContent = seconds.toString().padStart(2, '0');
        }
        
        // Update countdown every second
        updateCountdown();
        setInterval(updateCountdown, 1000);
        
        // Initialize Promotions Carousel
        const promotionsCarousel = new bootstrap.Carousel(document.getElementById('promotionsCarousel'), {
            interval: 5000,
            ride: 'carousel',
            pause: 'hover'
        });
        
        // Add smooth scroll behavior
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
        
        // Add animation on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);
        
        // Observe product cards and category cards
        document.querySelectorAll('.product-card, .category-card').forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(20px)';
            el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(el);
        });
    });
</script>
