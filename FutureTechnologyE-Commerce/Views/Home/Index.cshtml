@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

@using FutureTechnologyE_Commerce.Models.ViewModels
@model HomeIndexViewModel
@{
    ViewData["Title"] = "Home Page";
}

<!-- Simple Hero Section -->
<section class="hero-section py-5 mb-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-3">Future Technology Store</h1>
                <p class="lead mb-4">Discover the latest in tech and electronics</p>
                <a asp-action="GetAllProducts" class="btn btn-primary btn-lg">Shop Now</a>
            </div>
            <div class="col-lg-6">
                <img src="/images/ASUS TUF Gaming F15 Gaming Laptop.jpeg" alt="Featured Product" class="img-fluid rounded">
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="categories-section py-4 mb-4">
    <div class="container">
        <h2 class="section-title mb-4">Shop By Categories</h2>
        <div class="row g-3">
            <div class="col-md-3 col-6">
                <div class="card text-center h-100">
                    <img src="~/images/lab.jpg" class="card-img-top p-3" alt="Laptops" style="height: 120px; object-fit: contain;">
                    <div class="card-body">
                        <h6 class="card-title">Laptops</h6>
                        <a asp-controller="Home" asp-action="GetAllLaptops" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card text-center h-100">
                    <img src="~/images/IMG-20250408-WA0021.jpg" class="card-img-top p-3" alt="Mouse" style="height: 120px; object-fit: contain;">
                    <div class="card-body">
                        <h6 class="card-title">Mouse</h6>
                        <a asp-controller="Home" asp-action="GetFilteredProducts" asp-route-categoryFilter="Mouse" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card text-center h-100">
                    <img src="~/images/hard.jpg" class="card-img-top p-3" alt="Storage" style="height: 120px; object-fit: contain;">
                    <div class="card-body">
                        <h6 class="card-title">Storage</h6>
                        <a asp-controller="Home" asp-action="GetFilteredProducts" asp-route-categoryFilter="Storage" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card text-center h-100">
                    <img src="~/images/printer.jpg" class="card-img-top p-3" alt="Printers" style="height: 120px; object-fit: contain;">
                    <div class="card-body">
                        <h6 class="card-title">Printers</h6>
                        <a asp-controller="Home" asp-action="GetFilteredProducts" asp-route-categoryFilter="Printer" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Best Sellers Section -->
@if (Model.Products != null && Model.Products.Any())
{
    <section class="products-section py-4 mb-4">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="section-title mb-0">Best Sellers</h2>
                <a asp-action="GetFilteredProducts" asp-controller="Home" asp-route-categoryFilter="bestseller" class="btn btn-outline-primary">View All</a>
            </div>
            <div class="row g-3">
                @foreach (var product in Model.Products.Take(8))
                {
                    <div class="col-lg-3 col-md-4 col-6">
                        <div class="card h-100">
                            <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;" onerror="this.src='/images/placeholder.svg'">
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title text-truncate">@product.Name</h6>
                                <div class="price-section mb-2">
                                    <span class="fw-bold text-primary">@product.Price.ToString("N0") EGP</span>
                                </div>
                                <div class="mt-auto">
                                    @if (SignInManager.IsSignedIn(User))
                                    {
                                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@product.ProductID" />
                                            <button type="submit" class="btn btn-primary btn-sm w-100" @(product.StockQuantity == 0 ? "disabled" : "")>
                                                Add to Cart
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-controller="Cart" asp-action="RequestAddToCartAfterLogin" asp-route-productId="@product.ProductID" class="btn btn-primary btn-sm w-100">
                                            Add to Cart
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Featured Laptops Section -->
@if (Model.Laptops != null && Model.Laptops.Any())
{
    <section class="laptops-section py-4 mb-4">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="section-title mb-0">Featured Laptops</h2>
                <a asp-action="GetAllLaptops" asp-controller="Home" class="btn btn-outline-primary">View All</a>
            </div>
            <div class="row g-3">
                @foreach (var laptop in Model.Laptops.Take(4))
                {
                    <div class="col-lg-3 col-md-4 col-6">
                        <div class="card h-100">
                            <img src="@laptop.ImageUrl" class="card-img-top" alt="@laptop.Name" style="height: 200px; object-fit: cover;" onerror="this.src='/images/placeholder.svg'">
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title text-truncate">@laptop.Name</h6>
                                <div class="price-section mb-2">
                                    <span class="fw-bold text-primary">@laptop.Price.ToString("N0") EGP</span>
                                </div>
                                <div class="mt-auto">
                                    @if (SignInManager.IsSignedIn(User))
                                    {
                                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@laptop.ProductID" />
                                            <button type="submit" class="btn btn-primary btn-sm w-100" @(laptop.StockQuantity == 0 ? "disabled" : "")>
                                                Add to Cart
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-controller="Cart" asp-action="RequestAddToCartAfterLogin" asp-route-productId="@laptop.ProductID" class="btn btn-primary btn-sm w-100">
                                            Add to Cart
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
