<!DOCTYPE html>
<html lang="en">

@using Microsoft.AspNetCore.Identity
@using FutureTechnologyE_Commerce.Models
@using FutureTechnologyE_Commerce.Utility
@inject SignInManager<ApplicationUser> SignInManager

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Future Technology E-Commerce</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #2563eb;
            --primary-hover: #1d4ed8;
            --secondary-color: #1e293b;
            --light-bg: #f8fafc;
            --text-color: #1e293b;
            --border-color: #e2e8f0;
            --border-radius: 8px;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
            --shadow-md: 0 4px 6px rgba(0,0,0,0.1);
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--text-color);
            background-color: var(--light-bg);
        }

        .navbar {
            background-color: white;
            box-shadow: var(--shadow-sm);
            padding: 0.5rem 0;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
            color: var(--primary-color);
        }

        .nav-link {
            color: var(--text-color);
            font-weight: 500;
            padding: 0.5rem 1rem;
        }

            .nav-link:hover {
                color: var(--primary-color);
            }

        .btn-primary {
            background: var(--primary-color);
            border: none;
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: var(--border-radius);
        }

            .btn-primary:hover {
                background: var(--primary-hover);
            }

        .btn-outline-primary {
            color: var(--primary-color);
            border: 1px solid var(--primary-color);
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: var(--border-radius);
        }

            .btn-outline-primary:hover {
                background: var(--primary-color);
                color: white;
            }

        .card {
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius);
            background: white;
            box-shadow: var(--shadow-sm);
        }

            .card:hover {
                box-shadow: var(--shadow-md);
            }

        .section-title {
            color: var(--text-color);
            font-weight: 700;
            font-size: 1.5rem;
        }

        .footer {
            background: var(--secondary-color);
            color: white;
            padding: 3rem 0 2rem;
        }

            .footer h5 {
                color: white;
                font-weight: 600;
                margin-bottom: 1rem;
            }

            .footer a {
                color: rgba(255,255,255,0.7);
                text-decoration: none;
            }

                .footer a:hover {
                    color: white;
                }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <b>Future Technology Store</b>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="GetAllProducts">All Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="GetAllLaptops">Laptops</a>
                    </li>
                </ul>

                <ul class="navbar-nav">
                    <li class="nav-item">
                        <form asp-controller="Home" asp-action="GetFilteredProducts" method="get" class="d-flex">
                            <input name="searchString" class="form-control me-2" type="search" placeholder="Search products...">
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </form>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cart" asp-action="Index">
                            <i class="bi bi-cart"></i> Cart
                        </a>
                    </li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person"></i> Account
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Profile</a></li>
                                
                                @if (User.IsInRole(SD.Role_Admin))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header text-primary">
                                        <i class="bi bi-shield-check me-1"></i> Admin
                                    </h6></li>
                                    <li><a class="dropdown-item text-primary" asp-controller="Admin" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="UserManagement">
                                        <i class="bi bi-people me-2"></i> User Management
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Index">
                                        <i class="bi bi-box me-2"></i> Products
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="Category" asp-action="Index">
                                        <i class="bi bi-tags me-2"></i> Categories
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="Order" asp-action="Index">
                                        <i class="bi bi-receipt me-2"></i> Orders
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="Promotions" asp-action="Index">
                                        <i class="bi bi-percent me-2"></i> Promotions
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="Inventory" asp-action="Index">
                                        <i class="bi bi-clipboard-data me-2"></i> Inventory
                                    </a></li>
                                }
                                
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Logout">Logout</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="py-3">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5>Future Technology Store</h5>
                    <p>Your trusted source for the latest technology and electronics.</p>
                </div>
                <div class="col-md-4">
                    <h5>Quick Links</h5>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Home" asp-action="GetAllProducts">All Products</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5>Contact Us</h5>
                    <p><i class="bi bi-telephone"></i> 012456789</p>
                    <p><i class="bi bi-envelope"></i> andrew.atef299@gmail.com</p>
                </div>
            </div>
            <hr class="my-4">
            <div class="text-center">
                <p>&copy; 2024 Future Technology E-Commerce. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
